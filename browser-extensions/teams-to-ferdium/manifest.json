{
  "manifest_version": 3,
  "name": "Teams to Ferdium",
  "version": "1.0",
  "description": "Hands Teams meeting links to url-router so they open in Ferdium's Teams service",
  "key": "",
  "permissions": ["declarativeNetRequest", "nativeMessaging", "tabs"],
  "host_permissions": [
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://teams.cloud.microsoft/*"
  ],
  "declarative_net_request": {
    "rule_resources": [{ "id": "teams", "enabled": true, "path": "rules.json" }]
  },
  "web_accessible_resources": [
    {
      "resources": ["open.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
