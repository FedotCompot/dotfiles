[Unit]
Description=Update selected AUR packages, built as %i
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment="PKGS=visual-studio-code-bin helium-browser-bin t3code-nightly-bin ferdium-nightly-bin talosctl-bin omnictl-bin freelens-bin"
# drop pikaur's regenerated .SRCINFO, it blocks git pull
ExecStartPre=/usr/bin/runuser -u %i -- /bin/sh -c 'for p; do \
  d=/home/%i/.local/share/pikaur/aur_repos/$$p; \
  if [ -d "$$d" ]; then git -C "$$d" checkout -- .; fi; \
  done' sh $PKGS
# root installs, builds drop to %i, same as pikaur's own sudo re-exec
ExecStart=/bin/sh -c 'exec pikaur -S --needed --noconfirm --noedit --nodiff \
  --pikaur-config /home/%i/.config/pikaur.conf \
  --user-id "$$(id -u %i)" --group-id "$$(id -g %i)" --home-dir /home/%i \
  "$$@"' sh $PKGS
Nice=19
IOSchedulingClass=idle
