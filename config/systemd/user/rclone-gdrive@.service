# instance = rclone remote name, created by gdrive-add
[Unit]
Description=Google Drive mount for rclone remote %i

[Service]
Type=notify
ExecStartPre=/usr/bin/mkdir -p %h/GoogleDrive/%i
# offline: keep the last known shared drives
ExecStartPre=-%h/.local/bin/gdrive-remotes %i
ExecStart=/usr/bin/rclone mount %i_all: %h/GoogleDrive/%i \
  --vfs-cache-mode full \
  --vfs-cache-max-size 5G \
  --dir-cache-time 1000h \
  --poll-interval 1m \
  --fast-list \
  --rc --rc-addr unix://%t/rclone-gdrive-%i.sock --rc-no-auth
# prefetch the whole tree like the drive app; polling keeps it fresh
ExecStartPost=/usr/bin/rclone rc --unix-socket %t/rclone-gdrive-%i.sock vfs/refresh recursive=true _async=true
# a crashed mount leaves a dead endpoint behind
ExecStopPost=-/usr/bin/fusermount3 -uz %h/GoogleDrive/%i
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
