#!/usr/bin/env bash
# default http(s) handler: Teams links go to Ferdium, personal sites to the personal browser, the rest to work
set -euo pipefail

browser_desktop_id=helium-work
personal_browser_desktop_id=helium-personal
ferdium_dir="$HOME/.config/Ferdium"
hosts_dir="${XDG_CONFIG_HOME:-$HOME/.config}/url-router"

read_hosts() {
  local file="$hosts_dir/$1"
  [[ -r "$file" ]] || return 0
  sed -e 's/#.*//' -e 's/[[:space:]]//g' -e '/^$/d' -e 's/.*/\L&/' "$file"
}

mapfile -t personal_hosts < <(read_hosts personal-hosts)
mapfile -t teams_hosts < <(read_hosts teams-hosts)

url_host() {
  [[ "${1,,}" =~ ^https?://([^/?#]*) ]] || return 1
  local authority="${BASH_REMATCH[1]##*@}"
  printf '%s' "${authority%:*}"
}

is_teams_url() {
  local host h
  [[ "${1,,}" == https://* ]] && host=$(url_host "$1") || return 1
  for h in "${teams_hosts[@]}"; do
    [[ "$host" == "$h" ]] && return 0
  done
  return 1
}

percent_decode() {
  local s="${1//+/ }"
  printf '%b' "${s//%/\\x}"
}

unwrap_google_redirect() {
  if [[ "$1" =~ ^https?://(www\.)?google\.[a-z.]+/url\?(.*&)?q=([^&]+) ]]; then
    percent_decode "${BASH_REMATCH[3]}"
  else
    printf '%s' "$1"
  fi
}

ferdium_running() {
  busctl --user --no-pager status org.ferdium.Ferdium >/dev/null 2>&1
}

teams_sidebar_slot() {
  sqlite3 -readonly "$ferdium_dir/server.sqlite" \
    "select 1 + count(*) from services
     where json_extract(settings, '\$.order') <
       (select json_extract(settings, '\$.order') from services where recipeId = 'msteams');"
}

is_personal_url() {
  local host h
  host=$(url_host "$1") || return 1
  for h in "${personal_hosts[@]}"; do
    [[ "$host" == "$h" || "$host" == *."$h" ]] && return 0
  done
  return 1
}

hypr() {
  hyprctl eval "return hl.dispatch($1)" >/dev/null
}

open_in_ferdium() {
  local tmp slot
  tmp=$(mktemp "$ferdium_dir/config/.msteams-open-url.XXXXXX")
  printf '%s\n' "$1" >"$tmp"
  mv -f "$tmp" "$ferdium_dir/config/msteams-open-url"

  if ! ferdium_running; then
    setsid -f ferdium >/dev/null 2>&1
    return
  fi
  hypr 'hl.dsp.focus{ window = "class:ferdium" }'
  slot=$(teams_sidebar_slot)
  if ((slot >= 1 && slot <= 9)); then
    hypr "hl.dsp.send_shortcut{ mods = \"CTRL\", key = \"$slot\", window = \"class:ferdium\" }"
  fi
}

open_in_browser() {
  gtk-launch "$browser_desktop_id" "$@"
}

open_in_personal_browser() {
  gtk-launch "$personal_browser_desktop_id" "$@"
}

if (($# == 0)); then
  open_in_browser
  exit
fi

for url in "$@"; do
  target=$(unwrap_google_redirect "$url")
  if is_teams_url "$target"; then
    open_in_ferdium "$target"
  elif is_personal_url "$target"; then
    open_in_personal_browser "$url"
  else
    open_in_browser "$url"
  fi
done
